# Пример настроек. Скопируйте в .env и заполните. Файл .env в Git не попадает.

# development | test | production
DJANGO_ENV=development
# В production обязательно: длинная случайная строка
DJANGO_SECRET_KEY=
DJANGO_DEBUG=
DATABASE_URL=postgresql://equistart:equistart@127.0.0.1:5432/equistart

# Точный адрес сайта и разрешённые имена хоста
APP_ORIGIN=http://127.0.0.1:8000
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Адрес reverse proxy (nginx), которому доверяется X-Forwarded-For
TRUSTED_PROXY_IPS=

# Подтверждение телефона при регистрации (обязательно до открытого запуска)
PHONE_VERIFICATION_REQUIRED=false
# console — код в журнал сервера (тест); smsru — шлюз SMS.ru
SMS_BACKEND=console
SMSRU_API_ID=

# Пароль БД для docker-compose (в продакшне — длинный случайный)
POSTGRES_PASSWORD=

# Реквизиты оператора персональных данных (ИП) — подставляются в политику и согласия
OPERATOR_NAME=
OPERATOR_INN=
OPERATOR_OGRNIP=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=
OPERATOR_SITE=
MEDIA_ROOT=

# Копии: каталог, срок хранения, второе хранилище (rclone remote:bucket/path)
BACKUP_DIR=/var/backups/equistart
KEEP_DAYS=30
RCLONE_REMOTE=

# Поддержка (ТЗ 13.2). Telegram — только контакт в подвале; письма — ответы поддержки и срочные обращения.
SUPPORT_TELEGRAM=
SUPPORT_ALERT_EMAIL=
# SMTP почтового сервиса в России (без EMAIL_HOST письма пишутся в журнал сервера)
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
